---
// Web3Forms' access key is designed to be public/client-side (like a
// form ID, not a secret) — it identifies where submissions get emailed,
// nothing more. Get one at https://web3forms.com (no account needed).
const web3formsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY;

// A plain native form POST rather than a fetch()-based submission: the
// free/no-signup Web3Forms key doesn't return CORS headers for
// cross-origin fetch, which silently blocks an AJAX submission in every
// browser — a full-page form POST isn't subject to CORS at all, so it
// works regardless of that restriction.
const thanksUrl = new URL('/contact/thanks', Astro.site).toString();
---

<form class="enquiry" action="https://api.web3forms.com/submit" method="POST">
  <input type="hidden" name="access_key" value={web3formsAccessKey} />
  <input type="hidden" name="subject" value="New booking enquiry — The Manchesters website" />
  <input type="hidden" name="redirect" value={thanksUrl} />
  <div class="row">
    <div class="field">
      <label for="name">Name</label>
      <input id="name" name="name" type="text" required autocomplete="name" />
    </div>
    <div class="field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" required autocomplete="email" />
    </div>
  </div>

  <div class="row">
    <div class="field">
      <label for="organisation">Cruise line, theatre or venue</label>
      <input id="organisation" name="organisation" type="text" />
    </div>
    <div class="field">
      <label for="show">Which show?</label>
      <select id="show" name="show">
        <option value="Not sure yet">Not sure yet</option>
        <option value="The Story of Fleetwood Mac">The Story of Fleetwood Mac</option>
        <option value="The Story of Queen">The Story of Queen</option>
        <option value="Tribute Mad">Tribute Mad</option>
        <option value="More than one">More than one</option>
      </select>
    </div>
  </div>

  <div class="field">
    <label for="message">Message</label>
    <textarea id="message" name="message" rows="5" required></textarea>
  </div>

  <!-- Honeypot — Web3Forms specifically recognises a "botcheck" field:
       real visitors never see or fill it, bots that blindly fill every
       field do, and Web3Forms silently drops the submission. -->
  <input type="checkbox" name="botcheck" class="visually-hidden" style="display:none" tabindex="-1" autocomplete="off" />

  <button type="submit" class="button button--primary">Send enquiry</button>
</form>

<style>
  .enquiry {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 40rem;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  label {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--text-dim);
  }

  input,
  select,
  textarea {
    font-family: var(--font-sans);
    font-size: 1rem;
    padding: 0.8em 1em;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: rgba(244, 242, 236, 0.06);
    color: var(--text);
  }

  textarea {
    resize: vertical;
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
