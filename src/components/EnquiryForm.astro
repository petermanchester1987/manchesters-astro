---
// Web3Forms' access key is designed to be public/client-side (like a
// form ID, not a secret) — it identifies where submissions get emailed,
// nothing more. Get one at https://web3forms.com (no account needed).
const web3formsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY;
---

<form class="enquiry" data-enquiry-form novalidate>
  <input type="hidden" name="access_key" value={web3formsAccessKey} />
  <div class="row">
    <div class="field">
      <label for="name">Name</label>
      <input id="name" name="name" type="text" required autocomplete="name" />
    </div>
    <div class="field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" required autocomplete="email" />
    </div>
  </div>

  <div class="row">
    <div class="field">
      <label for="organisation">Cruise line, theatre or venue</label>
      <input id="organisation" name="organisation" type="text" />
    </div>
    <div class="field">
      <label for="show">Which show?</label>
      <select id="show" name="show">
        <option value="Not sure yet">Not sure yet</option>
        <option value="The Story of Fleetwood Mac">The Story of Fleetwood Mac</option>
        <option value="The Story of Queen">The Story of Queen</option>
        <option value="Tribute Mad">Tribute Mad</option>
        <option value="More than one">More than one</option>
      </select>
    </div>
  </div>

  <div class="field">
    <label for="message">Message</label>
    <textarea id="message" name="message" rows="5" required></textarea>
  </div>

  <!-- Honeypot — Web3Forms specifically recognises a "botcheck" field:
       real visitors never see or fill it, bots that blindly fill every
       field do, and Web3Forms silently drops the submission. -->
  <input type="checkbox" name="botcheck" class="visually-hidden" style="display:none" tabindex="-1" autocomplete="off" />

  <button type="submit" class="button button--primary">Send enquiry</button>
  <p class="status" role="status" aria-live="polite"></p>
</form>

<style>
  .enquiry {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 40rem;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  label {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--text-dim);
  }

  input,
  select,
  textarea {
    font-family: var(--font-sans);
    font-size: 1rem;
    padding: 0.8em 1em;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: rgba(244, 242, 236, 0.06);
    color: var(--text);
  }

  textarea {
    resize: vertical;
  }

  .status {
    color: var(--text-dim);
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-enquiry-form]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const status = form.querySelector<HTMLParagraphElement>('.status');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const formData = new FormData(form);

    if (status) status.textContent = 'Sending…';
    if (button) button.disabled = true;

    const name = formData.get('name');
    const organisation = formData.get('organisation');
    formData.set('subject', `Booking enquiry from ${name}${organisation ? ` (${organisation})` : ''}`);

    try {
      // Web3Forms only enables CORS for JSON bodies — a FormData/
      // multipart request gets silently blocked by the browser before
      // it even reaches their server.
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(formData)),
      });
      const result = await response.json();

      if (response.ok && result.success) {
        form.reset();
        if (status) status.textContent = "Thanks — we'll be in touch soon.";
      } else {
        if (status) status.textContent = result.message ?? 'Something went wrong. Please email us directly.';
      }
    } catch {
      if (status) status.textContent = 'Something went wrong. Please email us directly.';
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>
