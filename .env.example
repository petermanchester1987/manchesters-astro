# Brevo (formerly Sendinblue) — used for both the mailing list signup
# and for sending the booking-enquiry notification email.
# Create a key at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The Brevo "List ID" to add newsletter signups to.
# Find it at: https://app.brevo.com/contact/list-listing -> click a list -> the number in the URL.
BREVO_LIST_ID=2

# Where booking enquiries should land. This should be a verified sender
# in Brevo (Senders, Domains & Dedicated IPs -> Senders).
BREVO_SENDER_EMAIL=hello@the-manchesters.com
BREVO_SENDER_NAME=The Manchesters website
BOOKINGS_EMAIL=bookings@the-manchesters.com

# Simple shared secret to protect the API routes from casual abuse.
# Generate any random string, e.g. `openssl rand -hex 16`.
FORM_HONEYPOT_FIELD=company_website
