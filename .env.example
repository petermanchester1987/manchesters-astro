# Brevo (formerly Sendinblue) — used for the mailing list signup only.
# Create a key at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The Brevo "List ID" to add newsletter signups to.
# Find it at: https://app.brevo.com/contact/list-listing -> click a list -> the number in the URL.
BREVO_LIST_ID=2

# Web3Forms — powers the booking-enquiry form directly from the browser
# (no server code involved). Get a free access key by entering the email
# address enquiries should land at (e.g. bookings@the-manchesters.com) at
# https://web3forms.com — no account/password needed. This key is meant
# to be public (it's submitted from client-side JS), not a secret.
PUBLIC_WEB3FORMS_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx